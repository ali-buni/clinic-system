APP_NAME=clinic_system
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinic_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# GPS Tracking (Traccar)
traccar_url=
traccar_api_key=

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS=storage/app/firebase/cmsp-1-firebase.json

# CipherSweet - Field-Level Encryption (PHI)
CIPHERSWEET_KEY=
CIPHERSWEET_BACKEND=nacl
CIPHERSWEET_PROVIDER=string

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://medisync.com/api/auth/google/callback

# AI Providers
AI_PROVIDER=openrouter

OLLAMA_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=360

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_TIMEOUT=60

GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=60
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Stripe Payments
# IMPORTANT: Change sk_test_* to sk_live_* and pk_test_* to pk_live_* for production
STRIPE_SECRET=
PUBLISHABLE_Key=
STRIPE_WEBHOOK_SECRET=
ACCOUNT_ID=
STRIPE_CURRENCY=usd
# IMPORTANT: Change these to your production domain URLs
STRIPE_SUCCESS_URL=https://medisync.com/payment/success
STRIPE_CANCEL_URL=https://medisync.com/payment/failed
STRIPE_CONNECTED_ACCOUNT_TYPE=express

# Passport (OAuth2)
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
