APP_NAME=MediSync
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://clinic-system-cs.infinityfree.me

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (InfinityFree MySQL)
# Host: sql123.infinityfree.com (from cPanel → MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=sql123.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_42344888_clinic_system
DB_USERNAME=if0_42344888
DB_PASSWORD=

# InfinityFree: Use file driver (no SSH for database sessions)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# InfinityFree: Use sync driver (no queue worker)
QUEUE_CONNECTION=sync

# InfinityFree: Use file driver (no Redis)
CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# GPS Tracking (Traccar)
traccar_url=
traccar_api_key=

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS=storage/app/firebase/cmsp-1-firebase.json

# CipherSweet - Field-Level Encryption (PHI)
CIPHERSWEET_KEY=
CIPHERSWEET_BACKEND=nacl
CIPHERSWEET_PROVIDER=string

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://clinic-system-cs.infinityfree.me/api/auth/google/callback

# AI Providers (Cloud-based)
AI_PROVIDER=openrouter,groq,deepseek

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_TIMEOUT=60

GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=60
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Stripe Payments
# IMPORTANT: Change sk_test_* to sk_live_* and pk_test_* to pk_live_* for production
STRIPE_SECRET=
PUBLISHABLE_Key=
STRIPE_WEBHOOK_SECRET=
ACCOUNT_ID=
STRIPE_CURRENCY=usd
# IMPORTANT: Change these to your production domain URLs
STRIPE_SUCCESS_URL=http://clinic-system-cs.infinityfree.me/payment/success
STRIPE_CANCEL_URL=http://clinic-system-cs.infinityfree.me/payment/failed
STRIPE_CONNECTED_ACCOUNT_TYPE=express

# Passport (OAuth2)
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
